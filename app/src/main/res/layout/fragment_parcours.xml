<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/AppStyle"
    tools:context=".fragments.FragmentParcours">

    <Button
        android:id="@+id/startParcours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="3dp"
        android:text="@string/creation_parcours" />

    <LinearLayout
        android:id="@+id/erreurPasDItineraire"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:gravity="center"
        android:visibility="gone">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:src="@android:drawable/ic_dialog_alert"
            android:contentDescription="@string/erreur_aucun_parcours"
            app:tint="@android:color/holo_orange_light" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textSize="@dimen/detail_client_taille_titres"
            android:text="@string/erreur_aucun_parcours"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/parcoursEnCours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/listes_marge_haute"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <TextView
            android:id="@+id/parcoursEnCoursTitre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginHorizontal="3dp"
            android:textSize="@dimen/detail_client_taille_titres"
            android:text=""
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_parcours_en_cours"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/parcoursEnPause"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/listes_marge_haute"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <TextView
            android:id="@+id/parcoursEnPauseTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:gravity="start"
            android:layout_marginHorizontal="3dp"
            android:textSize="@dimen/detail_client_taille_titres"
            android:text="Parcours en pause (X) :"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_parcours_en_pause"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/parcoursArretes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/listes_marge_haute"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <TextView
            android:id="@+id/parcoursArretesTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:gravity="start"
            android:layout_marginHorizontal="3dp"
            android:textSize="@dimen/detail_client_taille_titres"
            android:text="Parcours arrêtés (X) :"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_parcours_arretes"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/parcoursTermines"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/listes_marge_haute"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        <TextView
            android:id="@+id/parcoursTerminesTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:gravity="start"
            android:layout_marginHorizontal="3dp"
            android:textSize="@dimen/detail_client_taille_titres"
            android:text="Parcours terminés (X) :"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_parcours_termines"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="10dp" />
    </LinearLayout>

</LinearLayout>